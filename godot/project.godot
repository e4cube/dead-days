config_version=5

[application]
config/name="Dead Days Rebuild"
run/main_scene="res://locations/integrated_world.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="DeadDaysRebuild"

[display]
window/size/viewport_width=1152
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.075, 0.09, 0.11, 1)
